{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "catppuccin-icons",
  "name": "Catppuccin Icons",
  "version": "0.2.0",
  "execution": "data",
  "description": "Soothing pastel file and folder icons, in Catppuccin Latte (light) and Mocha (dark).",
  "license": "MIT",
  "repository": "https://github.com/vincentferniot/catppuccin-orca-icons",
  "cover": {
    "path": "assets/cover.webp",
    "alt": "A diagonal mosaic of Catppuccin file icons, from the light Latte flavor to the dark Mocha flavor."
  },
  "engines": {
    "orca": ">=1.4.246"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "catppuccin-latte",
        "title": "Catppuccin Latte",
        "path": "themes/latte.json"
      },
      {
        "id": "catppuccin-mocha",
        "title": "Catppuccin Mocha",
        "path": "themes/mocha.json"
      }
    ]
  }
}
